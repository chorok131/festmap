# ── macOS ──
.DS_Store

# ── 임시/대용량 ──
/tmp/
*.log

# ── Flutter 빌드 산출물 (용량 큼, 재생성 가능) ──
app/build/
app/.dart_tool/
app/.flutter-plugins
app/.flutter-plugins-dependencies
app/.packages
app/pubspec.lock
app/**/build/

# iOS
app/ios/Pods/
