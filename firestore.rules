rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────────────────────
    // 보안 모델 메모 (2026-07 개정 · Auth 전환)
    //  편집(셀프편집 live 쓰기)은 Firebase Auth 소유자 로그인으로만 허용한다.
    //  소유자 = events/{slug}/private/meta 문서의 owners 배열에 uid가 든 계정.
    //  이 배열은 클라이언트가 못 쓰고(콘솔에서만 시드), 소유자 본인만 읽을 수 있어
    //  "내가 소유자냐"를 읽기 성공 여부로 판정한다(uid 목록 비노출).
    //  ─ 분석(sessions/daily)은 익명 방문자 핑이라 로그인 없이 쓰기 유지.
    //  ─ 목표: ① 개인정보(세션 원본) 읽기 차단 ② 편집 쓰기=소유자 전용(반달리즘 차단)
    //         ③ 대용량/삭제 남용 차단 ④ 분석은 익명 유지.
    // ─────────────────────────────────────────────────────────────
    function isOwner(slug) {
      return request.auth != null
        && exists(/databases/$(database)/documents/events/$(slug)/private/meta)
        && request.auth.uid in get(/databases/$(database)/documents/events/$(slug)/private/meta).data.owners;
    }

    // 원천 세션 기록: 개인 동선 원본(D단계). 쓰기만, 읽기/삭제 영구 차단.
    match /events/{slug}/sessions/{sid} {
      allow create, update: if true;
      allow read, delete: if false;
    }

    // 일별 집계: 익명 카운터(opens/locates/격자 h_*). 개인정보 아님 → 공개 읽기 유지
    // (report.html이 클라이언트에서 직접 조회). 쓰기는 익명 방문자 핑에 필요해 열되,
    // 삭제는 차단해 집계 데이터 통삭제 남용을 막는다.
    match /events/{slug}/daily/{day} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }

    // 셀프 편집 저장본(핀/라벨): 뷰어가 읽어야 해 공개 읽기.
    // 쓰기·삭제는 소유자(로그인)만 → 반달리즘 차단. pois는 JSON 문자열(정상 수 KB)이라 길이 상한 유지.
    match /events/{slug}/live/{doc} {
      allow read: if true;
      allow create, update: if isOwner(slug)
                             && request.resource.data.pois is string
                             && request.resource.data.pois.size() < 300000;
      allow delete: if isOwner(slug);   // '원본 되돌리기'도 소유자만
    }

    // 소유자 등록부(owners: [uid,...]). 소유자 본인만 읽기(=소유권 자기확인용).
    // 쓰기는 클라이언트 전면 차단 → 소유자 추가/변경은 Firebase 콘솔(관리자)에서만.
    match /events/{slug}/private/{doc} {
      allow read: if request.auth != null
                  && resource != null
                  && request.auth.uid in resource.data.owners;
      allow write: if false;
    }
  }
}
